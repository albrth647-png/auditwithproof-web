---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const casos = (await getCollection('casos', ({ data }) => data.estado === 'publicado')).sort(
  (a, b) => (a.data.fecha < b.data.fecha ? 1 : -1),
);

// Los enlaces internos llevan el base de GitHub Pages.
const RAW = import.meta.env.BASE_URL;
const B = RAW.endsWith('/') ? RAW.slice(0, -1) : RAW;

function resumen(body: string | undefined, max = 180): string {
  const texto = (body ?? '')
    .replace(/^---[\s\S]*?---/, '')
    .replace(/^#{1,6}\s+.*$/gm, '')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[*_`>|]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  return texto.length > max ? `${texto.slice(0, max).trimEnd()}…` : texto;
}
---

<Base
  title="Audit with Proof — Casos"
  description="Casos públicos de auditoría de seguridad en apps Electron, con evidencia verificable y límites declarados."
>
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 opacity-40"
      style="background-image: radial-gradient(#5c7186 1px, transparent 1px); background-size: 28px 28px;"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-5xl px-6 py-20 sm:py-24">
      <p class="font-display text-xs font-bold uppercase tracking-widest text-brand">
        Casos públicos
      </p>
      <h1 class="mt-3 font-display text-3xl font-bold sm:text-4xl">Casos de auditoría</h1>
      <p class="mt-4 max-w-2xl text-muted">
        Un caso = una página. Cada una sale de su ficha verificada, con los
        <span class="text-ink">evidence_id</span> y la §6 de límites declarada.
      </p>

      {casos.length === 0 && (
        <p class="mt-10 text-muted">Todavía no hay casos publicados.</p>
      )}

      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {casos.map((caso) => (
          <article class="flex flex-col rounded-2xl border border-muted/40 bg-base p-6 transition-colors hover:border-brand">
            <p class="font-display text-xs font-bold uppercase tracking-widest text-brand">
              Caso público · {caso.data.fecha}
            </p>
            <h2 class="mt-2 font-display text-xl font-bold">{caso.data.titulo}</h2>
            <p class="mt-1 text-sm text-muted">Versión analizada: {caso.data.version}</p>
            <p class="mt-4 flex-1 text-sm leading-relaxed text-muted">
              {resumen(caso.body)}
            </p>
            <a
              href={`${B}/casos/${caso.id}/`}
              class="mt-6 inline-flex items-center self-start rounded-full bg-brand px-4 py-2 text-sm font-semibold text-ink transition hover:opacity-90"
            >
              Ver informe →
            </a>
          </article>
        ))}
      </div>

      <a href={`${B}/`} class="mt-12 inline-block text-sm text-brand hover:underline">
        ← Inicio
      </a>
    </div>
  </section>
</Base>
