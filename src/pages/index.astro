---
import Base from '../layouts/Base.astro';

const pilares = [
  {
    titulo: 'Verificable',
    texto:
      'Cada observación lleva un evidence_id: el SHA-256 de la proyección semántica del documento. Un tercero puede recomputarlo sin confiar en nosotros.',
  },
  {
    titulo: 'Honesto',
    texto:
      'Lo que no se pudo determinar va en la §6, como primera clase y no como nota al pie. Esa sección es el producto.',
  },
  {
    titulo: 'Legal por construcción',
    texto:
      'Solo apps open source, propias o autorizadas por escrito. Nunca DRM, anti-cheat ni evasión de licencias.',
  },
];
---

<Base
  title="Audit with Proof — auditorías de seguridad para apps Electron"
  description="Auditorías de seguridad y riesgo de dependencias para apps Electron/JS: informe con evidencia verificable y límites declarados. 48 h · 150 USDT."
>
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <!-- rejilla de puntos (el gris detalle de la marca) -->
    <div
      class="pointer-events-none absolute inset-0 opacity-40"
      style="background-image: radial-gradient(#5c7186 1px, transparent 1px); background-size: 28px 28px;"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-5xl px-6 py-20 sm:py-28">
      <p class="font-display text-sm font-bold uppercase tracking-widest text-brand">
        Audit with Proof
      </p>
      <h1
        class="mt-4 max-w-3xl font-display text-4xl font-bold leading-tight sm:text-5xl"
      >
        Auditorías de seguridad para apps Electron, con
        <span class="text-brand">evidencia verificable</span>.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-muted">
        Analizamos tu artefacto de forma estática y solo lectura. Recibes un
        informe con evidencia que un tercero puede recomputar — y una sección
        de límites declarada, que es lo que no ofrece un escáner automático.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="#solicitud"
          class="rounded-full bg-brand px-6 py-3 font-semibold text-base transition hover:opacity-90"
        >
          Solicitar auditoría · 48 h · 150 USDT
        </a>
        <a
          href="#como-trabajamos"
          class="rounded-full border border-muted px-6 py-3 font-semibold text-ink transition hover:border-brand hover:text-brand"
        >
          Cómo trabajamos
        </a>
      </div>
    </div>
  </section>

  <!-- TRES PILARES -->
  <section id="como-trabajamos" class="mx-auto max-w-5xl px-6 py-16">
    <div class="grid gap-6 sm:grid-cols-3">
      {
        pilares.map((p) => (
          <article class="rounded-2xl border border-muted/40 bg-base p-6">
            <div class="h-1 w-12 bg-brand" aria-hidden="true" />
            <h2 class="mt-4 font-display text-xl font-bold">{p.titulo}</h2>
            <p class="mt-3 text-sm leading-relaxed text-muted">{p.texto}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section id="solicitud" class="mx-auto max-w-5xl px-6 pb-20">
    <div class="rounded-2xl border border-brand/60 bg-base p-8 sm:p-10">
      <h2 class="font-display text-2xl font-bold sm:text-3xl">
        ¿Tu app es Electron?
      </h2>
      <p class="mt-3 max-w-2xl text-muted">
        Envíanos el artefacto y la versión. En 48 horas tienes el informe con
        evidencia verificable y los límites declarados.
      </p>
      <a
        href="mailto:florito64.1@gmail.com?subject=Solicitud%20de%20auditor%C3%ADa%20Electron"
        class="mt-6 inline-block rounded-full bg-brand px-6 py-3 font-semibold text-base transition hover:opacity-90"
      >
        Escribir a florito64.1@gmail.com
      </a>
      <p class="mt-4 text-sm text-muted">
        150 USDT (USDT o USDC en TRC-20 / BEP-20) · sin tarjeta
      </p>
    </div>
  </section>
</Base>
