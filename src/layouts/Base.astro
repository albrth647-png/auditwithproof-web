---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Auditorías de seguridad de apps Electron/JS con evidencia que un tercero puede recomputar. 48 h · 150 USDT.',
} = Astro.props;

const RAW = import.meta.env.BASE_URL;
const B = RAW.endsWith('/') ? RAW.slice(0, -1) : RAW;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a121c" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${B}/og.png`} />
    <link rel="icon" type="image/png" href={`${B}/favicon.png`} />
  </head>
  <body class="min-h-screen bg-base font-sans text-ink antialiased">
    <header class="border-b border-muted/40">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
        <a href={`${B}/`} class="flex items-center">
          <img
            src={`${B}/brand/wordmark.png`}
            alt="Audit with Proof"
            width="180"
            height="40"
            class="h-9 w-auto"
          />
        </a>
        <a
          href="#solicitud"
          class="rounded-full border border-brand px-4 py-2 text-sm font-semibold text-brand transition hover:bg-brand hover:text-base"
        >
          Solicitar auditoría
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-muted/40">
      <div class="mx-auto max-w-5xl px-6 py-10 text-sm text-muted">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <img
            src={`${B}/brand/wordmark.png`}
            alt="Audit with Proof"
            width="160"
            height="36"
            class="h-8 w-auto"
          />
          <p class="text-ink">
            48 h · 150 USDT (USDT o USDC en TRC-20 / BEP-20)
          </p>
        </div>
        <p class="mt-4">
          Solo apps <strong class="text-ink">open source</strong>, propias o
          autorizadas por escrito. ·
          <a href="mailto:florito64.1@gmail.com" class="text-brand hover:underline">
            florito64.1@gmail.com
          </a>
        </p>
        <p class="mt-2">© {year} Audit with Proof</p>
      </div>
    </footer>
  </body>
</html>
