---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Auditorías de seguridad de apps Electron/JS con evidencia que un tercero puede recomputar. 48 h · 150 USDT.',
} = Astro.props;

const RAW = import.meta.env.BASE_URL;
const B = RAW.endsWith('/') ? RAW.slice(0, -1) : RAW;
// og:image tiene que ser absoluta: los crawlers no resuelven relativas.
const OG = new URL(`${B}/og.png`, import.meta.env.SITE).href;
// Canonical absoluta: incluye el base de Pages y resuelve la ruta real de cada página.
const CANON = new URL(Astro.url.pathname, import.meta.env.SITE).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a121c" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={OG} />
    <meta property="og:url" content={CANON} />
    <meta property="og:site_name" content="Audit with Proof" />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={CANON} />
    <link rel="icon" type="image/png" href={`${B}/favicon.png`} />
  </head>
  <body class="min-h-screen bg-base font-sans text-ink antialiased">
    <header class="border-b border-muted/40">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
        <a href={`${B}/`} class="flex items-center" aria-label="Audit with Proof — inicio">
          <!-- En móvil, el símbolo: el wordmark completo + nav no cabe a 360 px. -->
          <img
            src={`${B}/brand/logo-512.png`}
            alt="Audit with Proof"
            width="36"
            height="36"
            class="h-9 w-9 sm:hidden"
          />
          <img
            src={`${B}/brand/wordmark.png`}
            alt="Audit with Proof"
            width="180"
            height="40"
            class="hidden h-9 w-auto sm:block"
          />
        </a>
        <nav aria-label="Principal" class="flex items-center gap-3 sm:gap-4">
          <a href={`${B}/casos/`} class="text-sm font-semibold text-muted transition hover:text-brand">
            Casos
          </a>
          <!-- ancla con base: `#solicitud` a secas solo existe en la home -->
          <a
            href={`${B}/#solicitud`}
            class="rounded-full border border-brand px-3 py-1.5 text-xs font-semibold text-brand transition hover:bg-brand hover:text-base sm:px-4 sm:py-2 sm:text-sm"
          >
            Solicitar auditoría
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-muted/40">
      <div class="mx-auto max-w-5xl px-6 py-10 text-sm text-muted">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <img
            src={`${B}/brand/wordmark.png`}
            alt="Audit with Proof"
            width="160"
            height="36"
            class="h-8 w-auto"
          />
          <p class="text-ink">
            48 h · 150 USDT (USDT o USDC en TRC-20 / BEP-20)
          </p>
        </div>
        <p class="mt-4">
          Solo apps <strong class="text-ink">open source</strong>, propias o
          autorizadas por escrito ·
          <a href="mailto:florito64.1@gmail.com" class="text-brand hover:underline">
            florito64.1@gmail.com
          </a>
        </p>
        <p class="mt-2">
          <a href={`${B}/privacidad/`} class="text-brand hover:underline">Privacidad</a>
          ·
          <a href={`${B}/terminos/`} class="text-brand hover:underline">Términos del servicio</a>
        </p>
        <p class="mt-2">© {year} Audit with Proof</p>
      </div>
    </footer>
  </body>
</html>
